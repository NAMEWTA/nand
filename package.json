		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
		"test:issue-regressions": "esbuild scripts/verify-issue-regressions.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-issue-regressions.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-issue-regressions.cjs",
