		"test:music-client": "esbuild scripts/verify-music-client.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-music-client.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-music-client.cjs",
