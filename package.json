		"test:card-new-note": "esbuild scripts/verify-card-new-note.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-card-new-note.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-card-new-note.cjs",
		"test:memo-markdown": "esbuild scripts/verify-memo-markdown.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-memo-markdown.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-memo-markdown.cjs",
