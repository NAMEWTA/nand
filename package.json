		"test:promise-callbacks": "node scripts/verify-promise-callbacks.mjs",
		"test:architecture": "node scripts/verify-architecture.mjs",
		"test:dashboard-isolation": "esbuild scripts/verify-dashboard-isolation.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-dashboard-isolation.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-dashboard-isolation.cjs",
		"test:card-panels": "esbuild scripts/verify-card-panels.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-card-panels.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-card-panels.cjs",
		"test:safety-regressions": "node scripts/run-safety-regressions.mjs",
		"test:all": "node scripts/run-all-tests.mjs",
		"test:reliability": "esbuild scripts/verify-reliability.ts --bundle --platform=node --format=cjs --outfile=scripts/tmp/verify-reliability.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node --test scripts/tmp/verify-reliability.cjs",
		"test:i18n": "node scripts/verify-i18n.mjs",
		"test:docs": "node scripts/verify-docs.mjs",
		"test:workbench-lifecycle": "esbuild scripts/verify-workbench-lifecycle.ts --bundle --platform=node --format=cjs --outfile=scripts/tmp/verify-workbench-lifecycle.cjs --log-level=warning && node --test scripts/tmp/verify-workbench-lifecycle.cjs",
		"test:workbench-entry": "node --test scripts/verify-workbench-entry.mjs",
		"test:styles": "node scripts/build-styles.mjs --check",
		"check:bundle": "node scripts/check-bundle.mjs --budget scripts/bundle-budget.json --enforce",
		"check:styles": "node scripts/check-styles.mjs",
		"test:unit": "vitest run",
		"check:similarity": "node scripts/check-similarity.mjs",
		"check:native": "cargo test --locked --manifest-path native/pty-server/Cargo.toml",
		"check:notices": "node scripts/third-party-notices.mjs --check",
		"notices": "node scripts/third-party-notices.mjs --write",
		"lint:css": "node scripts/lint-css.mjs"
	},
	"keywords": [],
	"license": "MIT",
	"packageManager": "pnpm@11.1.3",
